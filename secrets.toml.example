# Copy this file to .streamlit/secrets.toml and fill in your key.


LLM_API_KEY = "paste-your-key-here"
 LLM_MODELS = "openai/gpt-oss-120b,openai/gpt-oss-20b"


# Optional. These defaults use Groq. Change them to use another provider.
# LLM_BASE_URL = "https://api.groq.com/openai/v1"
# LLM_MODELS = "openai/gpt-oss-120b,openai/gpt-oss-20b"
